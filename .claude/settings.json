{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_validate.py\"",
            "timeout": 60,
            "statusMessage": "Checking Stratezone content data"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_validate.py\"",
            "timeout": 300,
            "statusMessage": "Running Stratezone build and smoke checks"
          }
        ]
      }
    ]
  }
}
