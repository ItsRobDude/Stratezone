# Godot local/editor state
.godot/
.mono/

# .NET build output
bin/
obj/

# Export/build artifacts
builds/
exports/
artifacts/

# Blender backup and autosave files
*.blend[0-9]
*.blend[0-9][0-9]
*.blend@

# Logs and temporary files
*.log
*.tmp
*.temp

# Local agent/worktree state (shared Claude settings, skills, and hooks are tracked)
.claude/worktrees/
.claude/settings.local.json
.claude/hook-state/
